<Project>
  <!-- Evaluated after each project body, so IsPackable set in the .csproj is visible here. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The public API of every package is recorded in PublicAPI.Shipped.txt (released) and PublicAPI.Unshipped.txt (added
    since): a change to it is a build warning until the files are updated, so a breaking change cannot slip into a
    minor version. Move Unshipped entries to Shipped when releasing.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
