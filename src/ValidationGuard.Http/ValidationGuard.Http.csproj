<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>ValidationGuard.Http</PackageId>
    <Title>ValidationGuard.Http</Title>
    <Description>RFC 9457 Problem Details projection for ValidationGuard entries with code-to-status mapping declared in assembly metadata and verified by a bundled analyzer.</Description>
    <PackageTags>validation;problem-details;rfc6901;rfc9457;aspnetcore;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValidationGuard\ValidationGuard.csproj" />
    <ProjectReference Include="..\ValidationGuard.Http.Analyzers\ValidationGuard.Http.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ValidationGuard.Http.Tests.Unit" />
  </ItemGroup>

  <Target Name="PackAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\ValidationGuard.Http.Analyzers\ValidationGuard.Http.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_ValidationGuardHttpAnalyzer" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ValidationGuardHttpAnalyzer)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
