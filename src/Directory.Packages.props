<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <!-- Keep in sync with tests/Directory.Packages.props: the analyzer tests compile against the same Roslyn version. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup Label="Localization">
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
