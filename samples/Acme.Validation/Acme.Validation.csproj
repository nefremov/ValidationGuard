<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A library extending ValidationGuard with its own errors. Like ValidationGuard.CommonErrors it depends only on the
    core packages; its HTTP statuses live in Acme.Validation.Http and its translations in Acme.Validation.Localization.
    Outside this repository, reference the ValidationGuard.CommonErrors package instead.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ValidationGuard\ValidationGuard.csproj" />
    <ProjectReference Include="..\..\src\ValidationGuard.CommonErrors\ValidationGuard.CommonErrors.csproj" />
  </ItemGroup>
</Project>
